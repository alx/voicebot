# WhatsApp Configuration (whatsapp-web.js)
# Get group ID by sending a message to the group and checking bot logs
# Format: 120363123456789@g.us for groups, 123456789@c.us for individual chats
VOICEBOT_GROUP_ID=

# Optional: Python command override
# PYTHON_CMD=python3

# Optional: Override default logging level
# LOG_LEVEL=INFO
